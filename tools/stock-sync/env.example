# Copy to .env (never commit) and load it, e.g.:  node --env-file=.env sync.mjs --dry-run
# Server = computer name (or IP). If agent runs on the SQL Server machine itself, use localhost.
MSSQL_SERVER=BigyaMainPC
# Named instance (BigyaMainPC\SQLSERVER). When set, MSSQL_PORT is ignored; needs SQL Server Browser (UDP 1434).
# Default instance instead? Remove MSSQL_INSTANCE and use MSSQL_PORT=1433.
MSSQL_INSTANCE=SQLSERVER
# MSSQL_PORT=1433
MSSQL_DATABASE=MSMAXX
MSSQL_USER=web_readonly
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# SYSBRANCHID (and optionally SYSWAREHOUSEID list) of each branch. Omit warehouseIds = every warehouse of the branch.
STOCK_BRANCH_MAP={"src":{"branchId":1},"sss":{"branchId":2},"kkl":{"branchId":3}}

SUPABASE_URL=
# service_role key: only on this office machine. Never in Vercel / browser / git.
SUPABASE_SERVICE_ROLE_KEY=
SYNC_INTERVAL_MINUTES=15
